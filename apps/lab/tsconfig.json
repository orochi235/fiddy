{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "fiddy": ["../../packages/fiddy/src/index.ts"],
      "@lab/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "weasel.vite.ts"]
}
